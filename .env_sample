# Database (Neon Postgres 16 — direct connection, not pooler)
# Get from: console.neon.tech → your project → Connect → Connection string
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# AWS Bedrock (for LLM resolver — week 4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# OpenAPI target
OPENAPI_SPEC_PATH=inputs/openapi.yaml
OPENAPI_BASE_URL=

# Auth (bearer token for /apply, /rollback, /report endpoints)
# Set to a strong random string. Never log or return this value.
TOUCHSTONE_AUTH_TOKEN=

# Demo mode (set to 1 to serve cached resolutions, no live LLM calls)
TOUCHSTONE_DEMO_MODE=0
