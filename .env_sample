# Neon Postgres — get from console.neon.tech → your project → Connect
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub token — needed for Contract Observer /apply (opens PRs on target repo)
# Requires `repo` scope on NithinBR-AI/touchstone-demo-target-repo
GITHUB_TOKEN=ghp_your_token_here

# Upstash Redis — needed for Poltergeist (Cache Drift) app
# Get from upstash.com → your database → REST API section
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Mantle LLM (Bedrock-backed, OpenAI-compatible) — needed for App 1 (Schema Drift) and App 2 (Contract Observer)
# App 3 (Poltergeist) uses MockResolver — cache fixes are deterministic, no LLM needed
# If not set, MantleResolver falls back to MockResolver (deterministic, no LLM calls)
MANTLE_API_KEY=your_mantle_api_key
MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
